	(text "Astable 555. Q1 (PNP) turns on while OUT is LOW (discharge phase).\nt_on  = 0.693 * R2 * C1          = 83 ms\nt_off = 0.693 * (R1 + R2) * C1   = 776 ms\nf = 1.16 Hz, LED duty 9.7 %\nI_digit = (VCC - Vce_sat - Vf) / R:  E 680R, C 820R\n  -> ~0.4 mA @3.3 V ... ~0.9 mA @5 V average per LED (shared, unballasted)\nQ1 base: (VCC - Veb) / 4.7k = 0.55 ... 0.9 mA, forced beta >= 10"
		(exclude_from_sim no)
		(at 30.48 35.56 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "a0aa6de7-d68d-5325-9deb-2cf646e449e4")
	)
